      "conditional": {
        "visible_text_needed": [
          "text_on_screen"
        ],
        "dialogue": [
          "speaker_dialogue",
          "voice_language"
        ],
        "multipart": [
          "seam_state"
        ],
        "commercial_product": [
          "product_identity_authority"
        ],
        "exact_timing": [
          "timing_authority"
        ]

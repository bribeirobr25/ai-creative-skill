      "conditional": {
        "multipart": [
          "chapter_seams"
        ],
        "product_real": [
          "product_identity_anchor"
        ],
        "dialogue": [
          "speech_roles"
        ],
        "user_requested_image_storyboard": [
          "visual_panels"
        ]
      },
      "optional": [
        "camera_suggestions",
        "lighting",
        "soundscape",
        "visual_panels",
        "alternative_treatments",
        "shot_time_ranges"

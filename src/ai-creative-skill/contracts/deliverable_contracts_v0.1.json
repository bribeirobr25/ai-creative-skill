      "conditional": {
        "pending_approval": [
          "approval_scope"
        ],
        "blocked": [
          "blocker_and_resolution"
        ],
        "dependent_task": [
          "dependency"
        ]
      },
      "optional": [
        "alternative_paths",
        "risk_of_skipping",
        "reusable_assets"
      ]

      "optional": [
        "text_on_screen",
        "camera_treatment",
        "soundscape",
        "storyboard_ref",
        "edit_plan",
        "optional_improvisation"
      ]
    },
    "REFERENCE_MANIFEST": {
      "required": [
        "reference_ids",
        "per_reference_role",
        "authority_and_excluded_inheritance",
